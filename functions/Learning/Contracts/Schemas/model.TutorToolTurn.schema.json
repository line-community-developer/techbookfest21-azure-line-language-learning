{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string"
    },
    "learnerMessageId": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "closed": {
      "type": "boolean"
    },
    "maxCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "calls": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "record": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "callId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "succeeded",
                      "failed",
                      "rejected"
                    ]
                  },
                  "durationMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "errorCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "callId",
                  "name",
                  "status",
                  "durationMs",
                  "errorCode"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "completed",
          "record",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "userId",
    "schemaVersion",
    "sessionId",
    "learnerMessageId",
    "expiresAt",
    "closed",
    "maxCalls",
    "calls"
  ],
  "additionalProperties": false
}
