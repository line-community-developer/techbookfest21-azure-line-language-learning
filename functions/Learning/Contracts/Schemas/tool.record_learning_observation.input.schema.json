{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string"
    },
    "grammarTopicId": {
      "type": "string"
    },
    "observationType": {
      "type": "string",
      "enum": [
        "grammar-error",
        "possible-misunderstanding",
        "correct-use"
      ]
    },
    "evidenceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "correction": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "messageId",
    "grammarTopicId",
    "observationType",
    "evidenceText",
    "correction",
    "confidence"
  ],
  "additionalProperties": false
}
