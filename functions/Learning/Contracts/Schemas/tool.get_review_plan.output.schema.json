{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewPlan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topicId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "reasonJa": {
                    "type": "string"
                  }
                },
                "required": [
                  "topicId",
                  "title",
                  "priority",
                  "reasonJa"
                ],
                "additionalProperties": false
              }
            },
            "practiceSessionIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "items",
            "practiceSessionIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reviewPlan"
  ],
  "additionalProperties": false
}
