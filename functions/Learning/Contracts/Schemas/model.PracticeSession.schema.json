{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "recommended",
        "topic",
        "review"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "targetTopicIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewPlanId": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "learner",
            "review-workflow",
            "tutor-tool",
            "demo-seed"
          ]
        },
        "refId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "refId"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "in-progress",
        "completed"
      ]
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string",
            "enum": [
              "multiple-choice",
              "cloze"
            ]
          },
          "grammarTopicId": {
            "type": "string"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "instructionJa": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correctAnswer": {
            "type": "string",
            "minLength": 1
          },
          "acceptedAnswers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanationJa": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generatedBy": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "mock",
                  "foundry",
                  "unavailable"
                ]
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "model"
            ],
            "additionalProperties": false
          },
          "generationId": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "deterministic",
                        "semantic"
                      ]
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ]
                    },
                    "messageJa": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "passed",
                    "severity",
                    "messageJa"
                  ],
                  "additionalProperties": false
                }
              },
              "semantic": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "pass",
                          "fail",
                          "uncertain"
                        ]
                      },
                      "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "rationaleJa": {
                        "type": "string"
                      },
                      "evaluator": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "mock",
                              "foundry",
                              "unavailable"
                            ]
                          },
                          "model": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "model"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "verdict",
                      "score",
                      "rationaleJa",
                      "evaluator"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evaluatedAt": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "checks",
              "semantic",
              "evaluatedAt"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sessionId",
          "order",
          "type",
          "grammarTopicId",
          "difficulty",
          "instructionJa",
          "prompt",
          "choices",
          "correctAnswer",
          "acceptedAnswers",
          "explanationJa",
          "ruleIds",
          "sourceIds",
          "generatedBy",
          "generationId",
          "validation"
        ],
        "additionalProperties": false
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "normalizedAnswer": {
            "type": "string"
          },
          "isCorrect": {
            "type": "boolean"
          },
          "feedbackCode": {
            "type": "string",
            "enum": [
              "correct",
              "incorrect",
              "accent-mismatch"
            ]
          },
          "masteryBefore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "masteryAfter": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "answeredAt": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "attemptId",
          "answer",
          "normalizedAnswer",
          "isCorrect",
          "feedbackCode",
          "masteryBefore",
          "masteryAfter",
          "answeredAt"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "answered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "correct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "accuracy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "total",
            "answered",
            "correct",
            "accuracy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "userId",
    "schemaVersion",
    "mode",
    "level",
    "targetTopicIds",
    "reviewPlanId",
    "origin",
    "status",
    "questions",
    "answers",
    "summary",
    "completedAt"
  ],
  "additionalProperties": false
}
