{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tutor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "avatarEmoji": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "avatarEmoji"
          ],
          "additionalProperties": false
        },
        "channel": {
          "type": "string",
          "enum": [
            "local-simulator",
            "line",
            "demo-seed"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "ended"
          ]
        },
        "theme": {
          "type": "string"
        },
        "focusTopics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topicId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "titleJa": {
                "type": "string"
              },
              "level": {
                "type": "string",
                "enum": [
                  "A1",
                  "A2",
                  "B1",
                  "B2",
                  "C1",
                  "C2"
                ]
              }
            },
            "required": [
              "topicId",
              "title",
              "titleJa",
              "level"
            ],
            "additionalProperties": false
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "learner",
                  "tutor"
                ]
              },
              "text": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "corrections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "grammarTopicId": {
                      "type": "string"
                    },
                    "incorrect": {
                      "type": "string"
                    },
                    "suggestion": {
                      "type": "string"
                    },
                    "explanationJa": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "grammarTopicId",
                    "incorrect",
                    "suggestion",
                    "explanationJa"
                  ],
                  "additionalProperties": false
                }
              },
              "retrievedSourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toolCalls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "callId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "succeeded",
                        "failed",
                        "rejected"
                      ]
                    },
                    "durationMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "errorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "callId",
                    "name",
                    "status",
                    "durationMs",
                    "errorCode"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "role",
              "text",
              "createdAt",
              "corrections",
              "retrievedSourceIds",
              "toolCalls"
            ],
            "additionalProperties": false
          }
        },
        "agent": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "mock",
                "foundry",
                "unavailable"
              ]
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "model"
          ],
          "additionalProperties": false
        },
        "analysisWorkflowRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tutor",
        "channel",
        "status",
        "theme",
        "focusTopics",
        "messages",
        "agent",
        "analysisWorkflowRunId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "workflowRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "workflowName": {
          "type": "string"
        },
        "subjectId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        },
        "runCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "completed",
                  "failed",
                  "skipped"
                ]
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "startedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "completedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "output": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "status",
              "attempts",
              "startedAt",
              "completedAt",
              "output",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "schemaVersion",
        "workflowName",
        "subjectId",
        "status",
        "runCount",
        "steps",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "session",
    "workflowRun"
  ],
  "additionalProperties": false
}
