{
  "name": "line-language-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "preview": "vite preview",
    "build": "pnpm --filter shared run build && tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('staticwebapp.config.json','dist/staticwebapp.config.json')\" && pnpm --filter bff run build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit && pnpm exec tsc --noEmit -p bff",
    "bff:start": "pnpm --filter bff run start",
    "functions:start": "cd functions && dotnet run",
    "contracts:export": "pnpm --filter shared run build && node shared/scripts/export-json-schemas.cjs",
    "contracts:check": "pnpm --filter shared run build && node shared/scripts/export-json-schemas.cjs --check",
    "test": "dotnet test tests/LineLanguageLearn.Tests --nologo",
    "seeds:export": "dotnet run --project tools/SeedData/SeedData.csproj",
    "seeds:check": "pnpm --filter shared run build && node tools/seeds.cjs check",
    "seeds:bootstrap:check": "pnpm --filter shared run build && node .github/scripts/test-learning-cosmos-bootstrap.mjs"
  },
  "dependencies": {
    "@line-language-learn/shared": "workspace:*",
    "@line/liff": "^2.31.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "swallowkit": "2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11 <13",
      "onFail": "error"
    }
  },
  "workspaces": [
    "shared",
    "bff"
  ]
}
